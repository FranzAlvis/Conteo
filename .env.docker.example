# Copiar este archivo a ".env" en la raíz del proyecto y completar los
# valores reales ANTES de levantar docker-compose.prod.yml por primera vez:
#
#   cp .env.docker.example .env
#   nano .env
#
# Este archivo (.env) nunca se sube a git (ver .gitignore).

# --- Base de datos ---
POSTGRES_USER=conteo_user
# Contraseña real de Postgres. Generar una, por ejemplo con:
#   openssl rand -base64 24
POSTGRES_PASSWORD=CAMBIAR_ESTA_CONTRASENA
POSTGRES_DB=conteo_votos_db

# --- Backend / JWT ---
# Secreto para firmar los tokens de sesión. Generar uno propio, por ejemplo:
#   openssl rand -base64 32
JWT_SECRET=CAMBIAR_ESTE_SECRETO
JWT_EXPIRES_IN=24h
MAX_UPLOAD_SIZE_MB=5

# --- Usuario ADMIN inicial ---
# Se crea una única vez, la primera vez que arranca el contenedor con la
# base de datos vacía. Después podés crear más usuarios (transcriptores,
# visores, otros admins) desde el propio sistema, en el módulo Usuarios.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CAMBIAR_ESTA_CONTRASENA
ADMIN_NOMBRE=Administrador del Sistema

# --- Puerto expuesto en la LAN ---
# Puerto donde la gente del evento abre la app en el navegador
# (http://<ip-de-la-laptop>:FRONTEND_PORT). 80 no requiere escribir puerto.
FRONTEND_PORT=80
