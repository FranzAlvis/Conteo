datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  TRANSCRIPTOR
  AYUDANTE
  VISOR
}

enum EstadoMesa {
  PENDIENTE
  EN_CARGA
  CARGADA
}

enum TipoMesa {
  ESTUDIANTIL
  DOCENTE
}

model User {
  id           String   @id @default(uuid())
  name         String
  username     String   @unique
  passwordHash String
  role         Role     @default(VISOR)
  isActive     Boolean  @default(true)
  avatar       String?
  telefono     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  mesasAsignadas     Mesa[]            @relation("TranscriptorMesas")
  delegadosAsignados Delegado[]        @relation("TranscriptorDelegados")
  actasSubidas       ActaMesa[]
  reseteosEjecutados ResetAuditoria[]

  @@map("users")
}

/// Catálogo de facultades / sedes de votación (mapa electoral)
model Facultad {
  id        String   @id @default(uuid())
  nombre    String   @unique
  keyword   String
  createdAt DateTime @default(now())

  mesas Mesa[]

  @@map("facultades")
}

model Cargo {
  id          String   @id @default(uuid())
  nombre      String
  descripcion String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  candidatos Candidato[]

  @@map("cargos")
}

model Candidato {
  id        String   @id @default(uuid())
  nombre    String
  lista     String
  cargoId   String
  cargo     Cargo    @relation(fields: [cargoId], references: [id], onDelete: Cascade)
  esPropio  Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  votos VotoMesa[]

  @@index([cargoId])
  @@map("candidatos")
}

model Mesa {
  id             String     @id @default(uuid())
  codigo         String     @unique
  facultadId     String
  facultad       Facultad   @relation(fields: [facultadId], references: [id])
  ubicacion      String     @default("Por definir")
  totalPadron    Int        @default(0)
  tipo           TipoMesa   @default(ESTUDIANTIL)
  ponderacion    Int        @default(1)
  estado         EstadoMesa @default(PENDIENTE)
  transcriptorId String?
  transcriptor   User?      @relation("TranscriptorMesas", fields: [transcriptorId], references: [id])
  observaciones  String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  votos     VotoMesa[]
  actas     ActaMesa[]
  delegados Delegado[]

  @@index([facultadId])
  @@index([transcriptorId])
  @@index([estado])
  @@map("mesas")
}

model Delegado {
  id             String   @id @default(uuid())
  nombre         String
  ci             String   @unique
  celular        String
  correo         String?
  mesaId         String?
  mesa           Mesa?    @relation(fields: [mesaId], references: [id])
  transcriptorId String?
  transcriptor   User?    @relation("TranscriptorDelegados", fields: [transcriptorId], references: [id])
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([mesaId])
  @@index([transcriptorId])
  @@map("delegados")
}

model VotoMesa {
  id          String    @id @default(uuid())
  mesaId      String
  mesa        Mesa      @relation(fields: [mesaId], references: [id], onDelete: Cascade)
  candidatoId String
  candidato   Candidato @relation(fields: [candidatoId], references: [id], onDelete: Cascade)
  cantidad    Int       @default(0)

  @@unique([mesaId, candidatoId])
  @@map("votos_mesa")
}

model ActaMesa {
  id            String   @id @default(uuid())
  mesaId        String
  mesa          Mesa     @relation(fields: [mesaId], references: [id], onDelete: Cascade)
  fotoUrl       String
  observaciones String?
  subidoPorId   String
  subidoPor     User     @relation(fields: [subidoPorId], references: [id])
  createdAt     DateTime @default(now())

  @@index([mesaId])
  @@map("actas_mesa")
}

/// Fila única de configuración global del proceso electoral
model Configuracion {
  id            Int      @id @default(1)
  conteoAbierto Boolean  @default(true)
  updatedAt     DateTime @updatedAt

  @@map("configuracion")
}

/// Registro de auditoría de cada "puesta en 0" del sistema (acción irreversible, solo ADMIN)
model ResetAuditoria {
  id              String   @id @default(uuid())
  ejecutadoPorId  String
  ejecutadoPor    User     @relation(fields: [ejecutadoPorId], references: [id])
  mesasReseteadas Int
  votosEliminados Int
  actasEliminadas Int
  createdAt       DateTime @default(now())

  @@index([ejecutadoPorId])
  @@map("reset_auditoria")
}
